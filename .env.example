# =====================================================================
#  Social Dashboard — variables d'environnement (EXEMPLE, valeurs factices)
#  Copier en .env (local) ou coller dans Dokploy > votre Compose > Environment.
#  Ne JAMAIS commiter le vrai fichier .env.
# =====================================================================

# ---------------------------------------------------------------------
# Général
# ---------------------------------------------------------------------
# URL publique du dashboard (https, sans / final). Sert à construire les
# URL de redirection OAuth et à vérifier l'origine des requêtes.
PUBLIC_URL=https://dashboard.birostweb.fr
# Port d'écoute interne de l'API (ne pas changer : nginx proxifie vers api:3000)
PORT=3000
NODE_ENV=production
# Fuseau horaire utilisé pour les séries journalières et les heures de publication
TZ=Europe/Paris

# ---------------------------------------------------------------------
# Sécurité (OBLIGATOIRE — l'API refuse de démarrer sans ces valeurs)
# ---------------------------------------------------------------------
# Format : pas de guillemets ni d'espace autour du "=". Dans les valeurs, évitez "$" (interprété
# comme une variable) et " #" (un # précédé d'un espace commence un commentaire et tronque la valeur).
# Mot de passe pour se connecter au dashboard (12 caractères minimum, long et unique)
DASHBOARD_PASSWORD=remplacez-moi-par-une-longue-phrase-de-passe
# Secret de signature des cookies de session. Générer avec :  openssl rand -hex 32
SESSION_SECRET=a-generer-avec-openssl-rand-hex-32
# Clé de chiffrement AES-256-GCM des tokens (64 caractères hex). Générer avec :  openssl rand -hex 32
# ATTENTION : si vous la changez, les comptes déjà connectés devront être reconnectés.
TOKEN_ENCRYPTION_KEY=a-generer-avec-openssl-rand-hex-32
# Durée d'une session de connexion (heures)
SESSION_TTL_HOURS=12
# Anti brute-force : nombre d'échecs autorisés par IP sur la fenêtre (minutes)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------------
# Cache des données réelles
# ---------------------------------------------------------------------
# Durée de mise en cache des réponses des plateformes (secondes) : ménage les quotas
CACHE_TTL_SECONDS=900
# Rafraîchissement automatique (tokens + relevé des followers) toutes les N heures (0 = désactivé)
REFRESH_INTERVAL_HOURS=6
# Compatibilité : les données fictives sont désactivées dans cette interface.
MOCK_FALLBACK=false

# ---------------------------------------------------------------------
# TikTok — https://developers.tiktok.com/  (Login Kit + Display API)
# ---------------------------------------------------------------------
TIKTOK_CLIENT_KEY=exempleclientkey123
TIKTOK_CLIENT_SECRET=exemple-client-secret-tiktok
# À déclarer à l'identique dans le portail TikTok (par défaut : PUBLIC_URL + /api/auth/tiktok/callback)
TIKTOK_REDIRECT_URI=https://dashboard.birostweb.fr/api/auth/tiktok/callback
# Scopes demandés (séparés par des virgules)
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
# Délai de base (ms) avant une nouvelle tentative après une erreur temporaire, doublé à chaque essai (0 à 10000).
TIKTOK_RETRY_DELAY_MS=500

# ---------------------------------------------------------------------
# Instagram — https://developers.facebook.com/apps/  (Instagram API with Instagram Login)
# Compte Instagram professionnel (Business ou Créateur) requis.
# ---------------------------------------------------------------------
# « Instagram App ID » / « Instagram App Secret » (onglet Instagram de l'app Meta, pas l'App ID Facebook)
INSTAGRAM_APP_ID=123456789012345
INSTAGRAM_APP_SECRET=exemple-app-secret-instagram
INSTAGRAM_REDIRECT_URI=https://dashboard.birostweb.fr/api/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights,instagram_business_manage_comments
# Version de l'API Graph (à mettre à jour quand Meta la déprécie)
INSTAGRAM_GRAPH_VERSION=v23.0
# Nombre maximal de publications dont les insights sont lus à chaque relevé (1 à 500).
INSTAGRAM_INSIGHT_MEDIA_MAX=120
# Nombre maximal de publications dont les commentaires sont lus (0 à 200).
INSTAGRAM_COMMENT_MEDIA_MAX=30
# Appels d'insights simultanés (1 à 10) : baisser en cas de limite de débit Meta.
INSTAGRAM_INSIGHT_CONCURRENCY=5

# ---------------------------------------------------------------------
# LinkedIn — https://www.linkedin.com/developers/apps
# (app LinkedIn n° 266544895 : cet « App ID » n'est PAS le Client ID OAuth, ne pas l'utiliser ici)
# ---------------------------------------------------------------------
# Onglet « Auth » de l'app : Client ID / Primary Client Secret. Le secret reste côté serveur uniquement.
LINKEDIN_CLIENT_ID=exempleclientid
LINKEDIN_CLIENT_SECRET=exemple-client-secret-linkedin
# À enregistrer À L'IDENTIQUE dans Auth > Authorized redirect URLs (sans / final) :
LINKEDIN_REDIRECT_URI=https://dashboard.birostweb.fr/api/auth/linkedin/callback
# ID numérique de la Page entreprise (URL d'admin : linkedin.com/company/146243022/admin/...).
# Accepte aussi urn:li:organization:146243022
LINKEDIN_ORGANIZATION_ID=146243022
# false tant que LinkedIn n'a PAS approuvé « Community Management API » pour l'app :
#   → état « En attente d'approbation LinkedIn » : aucun OAuth lancé, aucune donnée (même fictive).
# true une fois le produit accordé ET les scopes visibles dans l'onglet Auth.
LINKEDIN_COMMUNITY_API=false
# Scopes demandés à l'OAuth (séparés par des espaces). Vide = défaut vérifié dans la doc :
#   "r_organization_social rw_organization_admin"
#   (rw_organization_admin : Page, followers, statistiques ; r_organization_social : publications)
# Ajoutez r_organization_social_feed (lecture des commentaires) UNIQUEMENT s'il figure dans l'onglet Auth,
# sinon LinkedIn refuse toute l'autorisation (unauthorized_scope_error).
LINKEDIN_SCOPES=
# Version de l'API REST (en-tête Linkedin-Version, AAAAMM). 202609 = « Latest » au 30/09/2026.
# LinkedIn garantit chaque version au moins 1 an : à mettre à jour au moins une fois par an.
LINKEDIN_API_VERSION=202609
# Budget d'appels LinkedIn par jour UTC (0 à 100). Quota Development tier : 100 appels/jour/membre :
# 80 laisse une marge pour les relectures manuelles. Jamais dépassé : les blocs restants sont reportés.
LINKEDIN_DAILY_CALL_BUDGET=80
# Part du budget réservée aux appels prioritaires (le détail commentaires/réactions s'arrête avant). Vide = un tiers, 25 au plus.
LINKEDIN_PRIORITY_RESERVE=
# Pages de publications lues (1 à 20, 50 publications par page).
LINKEDIN_MAX_POST_PAGES=5
# Fenêtre des statistiques de Page, en jours (1 à 365), et granularité : DAY ou MONTH.
LINKEDIN_PAGE_STATS_DAYS=90
LINKEDIN_PAGE_STATS_GRANULARITY=DAY
# Publications dont on lit les réactions par type / les commentaires (0 à 100) : chaque publication coûte 1 appel.
LINKEDIN_REACTIONS_MAX_POSTS=15
LINKEDIN_COMMENTS_MAX_POSTS=15
# Format de la liste d'identifiants des statistiques par publication : list (défaut) ou indexed (repli si LinkedIn répond 400).
LINKEDIN_SHARE_STATS_LIST_STYLE=list
# Durée du cache LinkedIn en secondes (défaut 43200 = 12 h, maximum 172800 = 48 h : le cache contient des commentaires de membres).
LINKEDIN_CACHE_TTL_SECONDS=43200
# Intervalle minimal entre deux relectures automatiques LinkedIn, en heures (défaut 12 : 2 relevés/jour dans le budget,
# même si REFRESH_INTERVAL_HOURS=6). L'actualisation manuelle respecte aussi le budget.
LINKEDIN_REFRESH_INTERVAL_HOURS=12

# ---------------------------------------------------------------------
# Dokploy — accès exclusivement depuis le backend, facultatif
# ---------------------------------------------------------------------
# URL de votre instance Dokploy : HTTPS recommandé, sans identifiants, sans /api ni / final.
# Domaine HTTPS (même VPS ou serveur distant) : https://dokploy.exemple.fr
# Même VPS Linux uniquement : http://host.docker.internal:3000
# Le service api ajoute host.docker.internal via host-gateway ; Dokploy doit être
# accessible depuis le pont Docker. Cette option HTTP reste interne au VPS.
# HTTP vers une IP publique est refusé : ne pas utiliser http://152.228.130.105:3000.
# Ne pas confondre avec PUBLIC_URL qui désigne le dashboard.
# À ajouter dans Dokploy > votre Compose > Environment, puis Redeploy.
DOKPLOY_URL=
# Clé créée dans Dokploy > Settings > API/CLI : jamais de valeur réelle dans Git.
# Une clé API HÉRITE des droits de son utilisateur : créez de préférence un utilisateur dédié
# au rôle minimal (lecture projets/déploiements/monitoring + déploiement). Avec une clé admin,
# le bouton Redéployer (et toute compromission du dashboard) ouvre tous les droits sur l'instance.
# Sans monitoring configuré dans Dokploy, les mesures du VPS restent « Indisponible » (état explicité dans l'interface).
# Le dashboard n'active jamais le monitoring de lui-même. Aucune autre variable n'est nécessaire.
DOKPLOY_API_KEY=

# ---------------------------------------------------------------------
# Mode en direct — facultatif (voir connexion.md §11)
# ---------------------------------------------------------------------
# Principe : l'API n'actualise TikTok / Instagram / Dokploy vite QUE lorsque l'application est ouverte
# (requête authentifiée ou POST /api/live/ping dans les LIVE_ACTIVE_WINDOW_SECONDS dernières secondes).
# Sinon tout est en pause (seuls le rafraîchissement des jetons et l'instantané quotidien d'abonnés continuent).
# LinkedIn n'est JAMAIS accéléré (100 appels/jour/membre).
LIVE_ENABLED=true
# Durée (30 à 900 s) pendant laquelle une requête ou un battement vaut « application utilisée ».
LIVE_ACTIVE_WINDOW_SECONDS=90
# Paliers Instagram : léger (compteurs, médias récents ; plancher 15 s) et lourd (insights par média, audience, commentaires ; plancher 60 s).
# Au défaut : ~240 + ~800 appels/h au plus, ouvert seulement ; quota Meta = 4800 x impressions / 24 h (très large).
LIVE_INSTAGRAM_LIGHT_SECONDS=60
LIVE_INSTAGRAM_HEAVY_SECONDS=900
# Paliers TikTok : léger (profil + 1re page de vidéos) et lourd (pagination complète, miniatures). ~165 appels/h au plus pour 600/min autorisés.
LIVE_TIKTOK_LIGHT_SECONDS=90
LIVE_TIKTOK_HEAVY_SECONDS=900
# Dokploy en direct (GET /api/infrastructure/live) : cache court des métriques (1000 à 60000 ms) et des statuts de services.
# La fraîcheur réelle des mesures dépend aussi du refreshRate du monitoring configuré DANS Dokploy (60 s par défaut, minimum 2 s).
LIVE_DOKPLOY_METRICS_TTL_MS=2000
LIVE_DOKPLOY_STATUS_TTL_MS=5000
# Limite de requêtes par minute et par session pour /api/infrastructure/live (30 à 600), séparée de celle des autres routes Dokploy (30/min).
LIVE_RATE_LIMIT_PER_MINUTE=90
# Cache persistant chiffré du dernier jeu de données (DATA_DIR/cache.enc.json) : affichage instantané après un redémarrage.
# Jamais de commentaires, de jetons ni d'activité de membres LinkedIn dans ce fichier.
PERSIST_CACHE=true
