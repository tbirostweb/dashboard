# =====================================================================
#  Dashboard BirostWeb — variables d'environnement (EXEMPLE : valeurs factices ou vides)
#  À coller dans Dokploy > service du dashboard > Environment, puis Redeploy.
#  Format : pas d'espace autour du « = ». Évitez « $ » dans les valeurs et « # » précédé d'un espace.
#  Ne JAMAIS commiter le vrai fichier .env ni coller ses valeurs dans un chat.
# =====================================================================

# --- Général -----------------------------------------------------------
# URL publique du dashboard (https, sans / final) : sert aux redirections OAuth et au contrôle d'origine.
PUBLIC_URL=https://dashboard.birostweb.fr

# --- Sécurité (OBLIGATOIRE : l'API refuse de démarrer sans ces trois valeurs) ---
# Mot de passe de connexion : 12 caractères minimum, une phrase de passe longue et unique est recommandée.
DASHBOARD_PASSWORD=
# Secret de signature des sessions :   openssl rand -hex 32
SESSION_SECRET=
# Clé de chiffrement des jetons (64 caractères hex) :   openssl rand -hex 32
# ATTENTION : la changer oblige à reconnecter TikTok, Instagram et LinkedIn.
TOKEN_ENCRYPTION_KEY=
# Facultatif : sous-réseau Docker réel de Traefik (docker network inspect dokploy-network), pour compter les tentatives de
# connexion par visiteur réel. Vide = toutes les plages privées (repli moins strict).
# TRUSTED_PROXY_CIDRS=

# --- LinkedIn — https://www.linkedin.com/developers/apps > votre app > Auth ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# ID numérique de la Page entreprise (URL d'admin : linkedin.com/company/<ID>/admin/)
LINKEDIN_ORGANIZATION_ID=
# false tant que LinkedIn n'a pas approuvé « Community Management API » ; true ensuite.
LINKEDIN_COMMUNITY_API=false

# --- Instagram — https://developers.facebook.com/apps/ > Instagram > API setup with Instagram login ---
# « Instagram App ID » / « Instagram App Secret » (pas l'App ID Facebook). Compte professionnel requis.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- TikTok — https://developers.tiktok.com/ > votre app (Login Kit + Display API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Serveurs : un Dokploy par VPS (connexions indépendantes) ----------------------------------------------------
# Dokploy > Settings > Profile > API/CLI > générer une clé. Une clé par Dokploy ; ne jamais réutiliser la même.
# Liste blanche des actions (Redéployer / Recharger) : noms ou ID de projets / services, séparés par des virgules.
# OBLIGATOIRE dès que l'URL est renseignée (sinon l'API refuse de démarrer).
# VPS 1
DOKPLOY_NAME=VPS 1
DOKPLOY_URL=https://dokploy.exemple.fr
DOKPLOY_API_KEY=
DOKPLOY_ACTION_ALLOWLIST=
# VPS 2 (facultatif : laisser vide pour un seul VPS)
DOKPLOY2_NAME=VPS 2
DOKPLOY2_URL=https://dokploy2.exemple.fr
DOKPLOY2_API_KEY=
DOKPLOY2_ACTION_ALLOWLIST=

# --- Site web : visiteurs (Umami auto-hébergé, lecture seule) ----------------------------------------------------
# Compose Umami : docker-compose.umami.yml (variables UMAMI_DB_PASSWORD et UMAMI_APP_SECRET dans SON Environment).
UMAMI_BASE_URL=https://umami.exemple.fr
# UUID du site : Umami > Websites > votre site > Settings.
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=admin
UMAMI_PASSWORD=

# --- Site web : Google Search Console (lecture seule, compte de service) ----------------------------------------
# 1) Google Cloud : projet > activer « Google Search Console API » > IAM > Comptes de service > créer > Clés > Ajouter une clé (JSON).
# 2) Search Console > Paramètres > Utilisateurs et autorisations > ajouter l'adresse du compte de service (rôle « Restreint »).
# Propriété : « sc-domain:birostweb.fr » pour une propriété de domaine, sinon l'URL exacte avec / final (https://birostweb.fr/).
GSC_SITE_URL=sc-domain:exemple.fr
# « client_email » du fichier JSON.
GSC_CLIENT_EMAIL=
# « private_key » du fichier JSON, sur UNE ligne, retours à la ligne écrits \n (les guillemets sont tolérés).
GSC_PRIVATE_KEY=
